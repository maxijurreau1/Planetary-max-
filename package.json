{
  "name": "beemax-portal-os1",
  "version": "1.0.0",
  "private": true,
  "description": "Edge-Native Distributed Microkernel, Multi-Agent Virtualization & Sovereign DAT Marketplace Layer",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute beemax-db --local --file=./src/database/schema.sql",
    "db:migrate:remote": "wrangler d1 execute beemax-db --remote --file=./src/database/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.2",
    "wrangler": "^3.90.0"
  }
}
